# Copy to .env and fill in your credentials
GEE_MODE=demo                      # "demo" | "live"
GEE_PROJECT_ID=                    # your-google-cloud-project-id (required for GEE Live Mode)
GEE_SERVICE_ACCOUNT=               # (optional) your-sa@project.iam.gserviceaccount.com
GEE_KEY_FILE=                      # (optional) path/to/service-account-key.json
CORS_ORIGINS=http://localhost:5173
